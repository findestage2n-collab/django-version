# Copier en `.env` (jamais commité). Remplacer les mots de passe avant utilisation.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
# Pour débuter sans MySQL (SQLite, un simple fichier) : DATABASE_URL=sqlite:///db.sqlite3
# Dans Docker Compose, l'URL par défaut utilise le service MySQL `db`.
# Pour remplacer l'URL dans le conteneur backend, définir COMPOSE_DATABASE_URL.
# COMPOSE_DATABASE_URL=postgres://utilisateur:mot-de-passe@hote:5432/hospital
DATABASE_URL=mysql://hospital:change-me@127.0.0.1:3306/hospital
# Aucune autre dépendance réseau : pas de Redis, pas de Celery, pas de CDN. Voir docs/06.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Utilisés par docker-compose pour initialiser MySQL
MYSQL_DATABASE=hospital
MYSQL_USER=hospital
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
MYSQL_PORT=3307
